FROM nginx:alpine

# Nginx with on-the-fly gzip compression only (no pre-compressed files)
RUN echo 'worker_processes 2; \
    \
    events { \
    worker_connections 1024; \
    } \
    \
    http { \
    include /etc/nginx/mime.types; \
    default_type application/octet-stream; \
    \
    # Performance optimizations \
    sendfile on; \
    tcp_nopush on; \
    tcp_nodelay on; \
    keepalive_timeout 65; \
    \
    # Enable file descriptor caching \
    open_file_cache max=1000 inactive=20s; \
    open_file_cache_valid 30s; \
    open_file_cache_min_uses 2; \
    open_file_cache_errors on; \
    \
    server { \
    listen 3000; \
    server_name localhost; \
    \
    root /var/www/html; \
    \
    # On-the-fly gzip compression \
    gzip on; \
    gzip_vary on; \
    gzip_min_length 1024; \
    gzip_comp_level 6; \
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/xml+rss application/json; \
    \
    # No browser caching \
    add_header Cache-Control "no-store, no-cache, must-revalidate"; \
    \
    location / { \
    try_files $uri $uri/ /index.html; \
    } \
    } \
    }' > /etc/nginx/nginx.conf

EXPOSE 3000

VOLUME ["/var/www/html"]

CMD ["nginx", "-g", "daemon off;"]
