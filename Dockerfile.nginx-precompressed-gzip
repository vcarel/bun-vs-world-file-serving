FROM nginx:1.31.8-alpine

ARG WORKERS=2

# Nginx with all optimizations: compression + file cache + browser cache
RUN echo "worker_processes ${WORKERS};" > /etc/nginx/nginx.conf && echo ' \
    events { \
    worker_connections 1024; \
    } \
    \
    http { \
    include /etc/nginx/mime.types; \
    default_type application/octet-stream; \
    \
    # The other servers do not log requests either \
    access_log off; \
    \
    # Performance optimizations \
    sendfile on; \
    tcp_nopush on; \
    tcp_nodelay on; \
    keepalive_timeout 65; \
    \
    # Enable file descriptor caching \
    open_file_cache max=1000 inactive=20s; \
    open_file_cache_valid 30s; \
    open_file_cache_min_uses 2; \
    open_file_cache_errors on; \
    \
    server { \
    listen 9000; \
    server_name localhost; \
    \
    root /var/www/html; \
    \
    # Serve pre-compressed .gz files if they exist \
    gzip_static on; \
    gzip_vary on; \
    \
    # Fallback gzip for files without .gz \
    gzip on; \
    gzip_min_length 1024; \
    gzip_comp_level 6; \
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/xml+rss application/json; \
    \
    # Browser caching headers \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ { \
    expires 1y; \
    add_header Cache-Control "public, immutable"; \
    } \
    \
    location / { \
    try_files $uri $uri/ /index.html; \
    } \
    } \
    }' >> /etc/nginx/nginx.conf

EXPOSE 9000

VOLUME ["/var/www/html"]

CMD ["nginx", "-g", "daemon off;"]
