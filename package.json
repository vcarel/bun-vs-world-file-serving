{
  "name": "bun-perf",
  "module": "index.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "bun build.ts",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "typecheck": "tsc --noEmit",
    "start:basic": "NODE_ENV=production USE_CACHE=false USE_GZIP=false bun cluster.ts",
    "start:gzip": "NODE_ENV=production USE_CACHE=false USE_GZIP=true bun cluster.ts",
    "start:cache": "NODE_ENV=production USE_CACHE=true USE_GZIP=false bun cluster.ts",
    "start:full": "NODE_ENV=production USE_CACHE=true USE_GZIP=true bun cluster.ts"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
